# Copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore - never commit it.

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Only emails ending with this are allowed to register.
# Clear it (ALLOWED_EMAIL_DOMAIN=) if you ever need to test with other emails.
ALLOWED_EMAIL_DOMAIN=@aupp.edu.kh

# --- Gemini AI matching (Step 3) ---
# Create a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=

# Which Gemini model to use. Google renames models often, so if matching fails
# with a "model not found" or quota error, run `python check_gemini.py` to see
# which models your key can use, then put one here.
GEMINI_MODEL=gemini-3.6-flash

# A pair is only reported as a potential match at or above this confidence
# (0.0 - 1.0). Raise it for fewer, surer matches; lower it for more.
MATCH_THRESHOLD=0.6

# --- Email notifications (Step 5) ---
# Leave MAIL_SERVER empty while testing: emails are then PRINTED in the server
# terminal (with the link) instead of being sent.
#
# To send real emails with a Gmail account (turn on 2-Step Verification, then
# create an "App password" at https://myaccount.google.com/apppasswords):
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=the-16-letter-app-password   (not your normal password)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Address shown as the sender (defaults to MAIL_USERNAME).
# MAIL_FROM=

# The address people use to reach the site. It is put in the email's link.
# Change it when the site is hosted somewhere other than your computer.
APP_BASE_URL=http://localhost:5000
