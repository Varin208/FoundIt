# Copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore - never commit it.

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Only emails ending with this are allowed to register.
# Clear it (ALLOWED_EMAIL_DOMAIN=) if you ever need to test with other emails.
ALLOWED_EMAIL_DOMAIN=@aupp.edu.kh

# --- Used in later steps (leave blank for now) ---
# GEMINI_API_KEY=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# APP_BASE_URL=http://localhost:5000
